{
  "tools": {
    "autoAccept": true,
    "allowed": [
      "LSTool",
      "ShellTool(ls)",
      "ReadFileTool",
      "WriteFileTool",
      "GrepTool",
      "GlobTool",
      "WebFetchTool",
      "WebSearchTool",
      "MemoryTool"
    ]
  },
  "mcpServers": {
    "context7": {
      "httpUrl": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "YOUR_API_KEY",
        "Accept": "application/json, text/event-stream"
      }
    }
  },
  "telemetry": {
    "enabled": false
  },
  "privacy": {
    "usageStatisticsEnabled": false
  },
  "security": {
    "auth": {
      "selectedType": "oauth-personal"
    }
  },
  "ui": {
    "showMemoryUsage": true,
    "footer": {
      "hideCWD": true,
      "hideSandboxStatus": true
    }
  },
  "context": {
    "fileName": [
      "./GEMINI.md",
      "./llm/PROJECT.md"
    ],
    "fileFiltering": {
      "respectGitIgnore": false
    }
  },
  "general": {
    "previewFeatures": true
  }
}
